*.pdf binary
*.zip binary
*.png binary
*.jpg binary
*.npz binary
*.svg text eol=lf
*.ipynb text eol=lf
*.csv text eol=lf

# Run histories are hashed as exported, including the original CRLF bytes.
results/development/**/history.csv -text !eol whitespace=cr-at-eol
results/label_noise/**/history.csv -text !eol whitespace=cr-at-eol
# Matplotlib SVG path data contains trailing spaces. Keep generated bytes intact.
assets/checkpoint2/*.svg whitespace=-blank-at-eol
